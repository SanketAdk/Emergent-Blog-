{
  "name": "emergent-thoughts",
  "version": "1.0.0",
  "description": "Essays on ideas that emerge from curiosity",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start -x studio,mailpit,logflare,vector,supavisor,imgproxy,edge-runtime,realtime,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > types/database.types.ts",
    "db:push": "supabase db push",
    "test": "vitest run",
    "studio:create-admin": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts",
    "content:import": "tsx --env-file-if-exists=.env.local scripts/import-content.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.16",
    "shadcn": "^4.23.0",
    "supabase": "^2.122.1",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
