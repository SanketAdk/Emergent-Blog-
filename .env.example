# ──────────────────────────────────────────────────────────────────────────────
# Emergent Thoughts: environment variables
#
# 1. Copy this file:   cp .env.example .env.local
# 2. Fill in the real values in .env.local (it is git-ignored).
# 3. Add the same variables in Vercel → Project → Settings → Environment Variables.
#
# NEVER commit real values. NEVER put a secret behind a NEXT_PUBLIC_ prefix:
# anything prefixed NEXT_PUBLIC_ is bundled into the browser.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (Dashboard → Project Settings → API Keys) ──
# Public: safe in the browser, because access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only secret. Bypasses RLS. Needed from Stage 4 (Studio login).
# Never import it into client components.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Site ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: Supabase CLI / CI only (GitHub Actions secrets, not Vercel) ──
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_DB_PASSWORD=your-database-password
